{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently \"pnpm db:start\" \"pnpm dev:nuxt\" --names \"MongoDB,Nuxt\" --prefix-colors \"green,blue\" --kill-others-on-fail",
    "dev:nuxt": "nuxt dev",
    "dev:standalone": "nuxt dev",
    "db:start": "mkdir -p ./data/db && mongod --dbpath ./data/db --port 27017 --quiet --logpath /dev/null",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.5.2",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.0.0",
    "@nuxt/ui": "^4.5.0",
    "eslint": "^10.0.2",
    "jsondiffpatch": "^0.7.3",
    "mongoose": "^9.2.3",
    "nuxt": "^4.3.1",
    "nuxt-mongoose": "^1.0.6",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
