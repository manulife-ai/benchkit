{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently \"npm run db:start\" \"npm run dev:nuxt\" --names \"MongoDB,Nuxt\" --prefix-colors \"green,blue\" --kill-others-on-fail",
    "dev:nuxt": "nuxt dev",
    "dev:standalone": "nuxt dev",
    "db:start": "mongod --dbpath ./data/db --port 27017  --quiet --logpath /dev/null",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.5.2",
    "@nuxt/image": "^1.10.0",
    "@nuxt/test-utils": "^3.19.2",
    "@nuxt/ui": "^3.2.0",
    "eslint": "^9.30.1",
    "jsondiffpatch": "^0.7.3",
    "mongoose": "^8.16.2",
    "nuxt": "^3.17.6",
    "nuxt-mongoose": "^1.0.6",
    "typescript": "^5.8.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3"
  }
}
